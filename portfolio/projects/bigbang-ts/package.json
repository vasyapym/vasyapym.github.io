{
  "name": "bigbang-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GPU-accelerated WebGL simulation of the Big Bang: inflation to the present day, 13.8 Gyr on log-time.",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --minify --outfile=dist/main.js",
    "watch": "esbuild src/main.ts --bundle --outfile=dist/main.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/cosmology.check.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
